<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ModPak.App.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <Color x:Key="SystemAccentColor">#5D0F39</Color>
        <Color x:Key="SystemAccentColorDark1">#450B2A</Color>
        <Color x:Key="SystemAccentColorDark2">#30081E</Color>
        <Color x:Key="SystemAccentColorLight1">#7E2052</Color>
        <Color x:Key="SystemAccentColorLight2">#9A2F62</Color>
        <Color x:Key="SystemAccentColorLight3">#B84A7A</Color>
        <SolidColorBrush x:Key="TextControlBackground" Color="#25201C" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2E2824" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2E2824" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#5D0F39" />
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
            <Setter Property="Background" Value="#14110F" />
            <Setter Property="Foreground" Value="#F3EDE6" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#A89888" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#C8B8A8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#25201C" />
            <Setter Property="BorderBrush" Value="#3F3731" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CaretBrush" Value="#9A2F62" />
            <Setter Property="Foreground" Value="#F3EDE6" />
        </Style>
        <Style Selector="Border.editor-frame">
            <Setter Property="Background" Value="#282C34" />
            <Setter Property="BorderBrush" Value="#3F3731" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Border.editor-frame:pointerover">
            <Setter Property="BorderBrush" Value="#4A423C" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="#2E2824" />
            <Setter Property="BorderBrush" Value="#5D0F39" />
            <Setter Property="Foreground" Value="#F3EDE6" />
        </Style>
        <Style Selector="TextBox.path-invalid">
            <Setter Property="BorderBrush" Value="#EC4899" />
        </Style>
        <Style Selector="TextBox.path-invalid:focus">
            <Setter Property="BorderBrush" Value="#F472B6" />
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="#14110F" />
            <Setter Property="Foreground" Value="#F3EDE6" />
            <Setter Property="BorderBrush" Value="#3F3731" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2A2521" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#5D0F39" />
            <Setter Property="Foreground" Value="#F3EDE6" />
        </Style>
        <Style Selector="ContextMenu MenuItem">
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Border.toolbar">
            <Setter Property="Background" Value="#1C1815" />
            <Setter Property="BorderBrush" Value="#2E2823" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="MinHeight" Value="78" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.tool-sep">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="8,10" />
            <Setter Property="Background" Value="#3F3731" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Foreground" Value="#F3EDE6" />
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2521" />
            <Setter Property="BorderBrush" Value="#3F3731" />
        </Style>
        <Style Selector="Button.tool:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#352F2A" />
        </Style>
        <Style Selector="Button.tool:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.tool:disabled">
            <Setter Property="Opacity" Value="0.42" />
        </Style>
        <Style Selector="Button.accent-tool">
            <Setter Property="Background" Value="#3A1528" />
            <Setter Property="BorderBrush" Value="#5D0F39" />
        </Style>
        <Style Selector="Button.accent-tool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#5D0F39" />
            <Setter Property="BorderBrush" Value="#7E2052" />
        </Style>
        <Style Selector="Button.accent-tool:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A0C2D" />
        </Style>
        <Style Selector="TextBlock.tool-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#D8CEC4" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1C1815" />
            <Setter Property="BorderBrush" Value="#2E2823" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#25201C" />
            <Setter Property="BorderBrush" Value="#3F3731" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#F3EDE6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TabControl">
            <Setter Property="Padding" Value="22,22,22,12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid RowDefinitions="Auto,*" ClipToBounds="False">
                        <Border Grid.Row="1"
                                Background="#1C1815"
                                BorderBrush="#2E2823"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,12,12">
                            <ContentPresenter Name="PART_SelectedContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                        </Border>
                        <Panel Grid.Row="0" ClipToBounds="False">
                            <Border Height="1"
                                    VerticalAlignment="Bottom"
                                    Background="#2E2823" />
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            ClipToBounds="False"
                                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </Panel>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Theme" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#A89888" />
            <Setter Property="Background" Value="#181410" />
            <Setter Property="BorderBrush" Value="#2E2823" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,0,-0.5" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabItem:pointerover">
            <Setter Property="Background" Value="#221C19" />
            <Setter Property="Foreground" Value="#E8DDD2" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="#1C1815" />
            <Setter Property="Foreground" Value="#F3EDE6" />
            <Setter Property="Margin" Value="0,0,0,-2" />
            <Setter Property="ZIndex" Value="1" />
        </Style>
        <Style Selector="TabItem:selected:pointerover">
            <Setter Property="Background" Value="#1C1815" />
            <Setter Property="Foreground" Value="#F3EDE6" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#F3EDE6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.clear">
            <Setter Property="Background" Value="#2A2521" />
            <Setter Property="BorderBrush" Value="#4A423C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Foreground" Value="#F3EDE6" />
        </Style>
        <Style Selector="Button.clear /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2521" />
            <Setter Property="BorderBrush" Value="#4A423C" />
        </Style>
        <Style Selector="Button.clear:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A342F" />
            <Setter Property="BorderBrush" Value="#6A5E54" />
        </Style>
        <Style Selector="Button.clear:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#221E1B" />
        </Style>
        <Style Selector="Button.clear:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#1C1815" />
            <Setter Property="BorderBrush" Value="#2E2823" />
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Button.clear.accent /template/ ContentPresenter">
            <Setter Property="Background" Value="#5D0F39" />
            <Setter Property="BorderBrush" Value="#7E2052" />
        </Style>
        <Style Selector="Button.clear.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#7E2052" />
            <Setter Property="BorderBrush" Value="#9A2F62" />
        </Style>
        <Style Selector="Button.clear.accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#450B2A" />
            <Setter Property="BorderBrush" Value="#5D0F39" />
        </Style>
        <Style Selector="Button.codec-chip">
            <Setter Property="Background" Value="#2A2521" />
            <Setter Property="BorderBrush" Value="#4A423C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.codec-chip /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2521" />
            <Setter Property="BorderBrush" Value="#4A423C" />
        </Style>
        <Style Selector="Button.codec-chip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A342F" />
            <Setter Property="BorderBrush" Value="#E0B878" />
        </Style>
        <Style Selector="Button.codec-chip:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="CheckBox.pane-multi">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#C8B8A8" />
        </Style>
        <Style Selector="Border.pane-status">
            <Setter Property="Background" Value="#25201C" />
            <Setter Property="BorderBrush" Value="#3F3731" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.pane-status.pane-footer">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style Selector="TextBlock.pane-status">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#D8CEC4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.pane-status-sep">
            <Setter Property="Text" Value="|" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#6A5E54" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button.fn">
            <!-- Keep list focus so the first click runs the action (no focus-only click). -->
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#2A2521" />
            <Setter Property="BorderBrush" Value="#4A423C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#F3EDE6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.fn /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2521" />
            <Setter Property="BorderBrush" Value="#4A423C" />
        </Style>
        <Style Selector="Button.fn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A342F" />
            <Setter Property="BorderBrush" Value="#6A5E54" />
        </Style>
        <Style Selector="Button.fn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#221E1B" />
        </Style>
        <Style Selector="Button.fn.accent /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A1528" />
            <Setter Property="BorderBrush" Value="#5D0F39" />
        </Style>
        <Style Selector="Button.fn.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#5D0F39" />
            <Setter Property="BorderBrush" Value="#7E2052" />
        </Style>
    </Application.Styles>
</Application>
